### Classes ###

sosa:ActuatableProperty rdfs:subClassOf emmo:EMMO_b7bcff25_ffc3_474e_9ab5_01b1664bd4ba .

sosa:Actuation rdfs:subClassOf emmo:EMMO_472a0ca2_58bf_4618_b561_6fe68bd9fd49 .

sosa:Actuator rdfs:subClassOf emmo:EMMO_494b372c_cfdf_47d3_a4de_5e037c540de8 .

sosa:FeatureOfInterest rdfs:subClassOf emmo:EMMO_6f5af708_f825_4feb_a0d1_a8d813d3022b .

sosa:ObservableProperty rdfs:subClassOf emmo:EMMO_b7bcff25_ffc3_474e_9ab5_01b1664bd4ba .

sosa:Observation rdfs:subClassOf emmo:EMMO_3b19eab4_79be_4b02_bdaf_ecf1f0067a68 .

sosa:Platform rdfs:subClassOf emmo:EMMO_494b372c_cfdf_47d3_a4de_5e037c540de8 .

sosa:Procedure rdfs:subClassOf emmo:EMMO_eaf4640d_651d_4cbe_a315_3d2dc5df3b35 .

sosa:Result rdfs:subClassOf emmo:EMMO_3e7add3d_e6ed_489a_a796_8e31fef9b490 .
sosa-emmo:alignmentNote1 a rdf:Statement ;
	rdf:subject sosa:Result ;
	rdf:predicate rdfs:subClassOf ;
	rdf:object emmo:EMMO_3e7add3d_e6ed_489a_a796_8e31fef9b490 ;
	emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "For more specific instances, sosa:Result could be aligned with (deemed a subclass of) chameo:CharacterisationData or emmo:MeasurementResult, for instance."@en .
	
sosa:Sample skos:closeMatch chameo:Sample .
chameo:Sample rdfs:subClassOf sosa:Sample .

sosa:Sampler rdfs:subClassOf emmo:EMMO_494b372c_cfdf_47d3_a4de_5e037c540de8 .
chameo:SampleExtractionInstrument rdfs:subClassOf sosa:Sampler .
chameo:SamplePreparationInstrument rdfs:subClassOf sosa:Sampler .

sosa:Sampling rdfs:subClassOf emmo:EMMO_472a0ca2_58bf_4618_b561_6fe68bd9fd49 .
chameo:SampleExtraction rdfs:subClassOf sosa:Sampling .
chameo:SamplePreparation rdfs:subClassOf sosa:Sampling .
sosa-emmo:alignmentNote2 a rdf:Statement ;
	rdf:subject sosa:Sampling ;
	rdf:predicate rdfs:subClassOf ;
	rdf:object emmo:EMMO_472a0ca2_58bf_4618_b561_6fe68bd9fd49 ;
	emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "For more specific cases, sosa:Sampling could be aligned with (deemed a subclass of) chameo:CharacterisationProcedure."@en .

sosa:Sensor: rdfs:subClassOf emmo:EMMO_ea67caa5_2609_4e91_98ae_81103f2d5c25 .

